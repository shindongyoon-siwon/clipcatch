{
  "manifest_version": 3,
  "name": "ClipCatch Browser",
  "version": "1.9.5",
  "description": "ClipCatch companion for selecting public videos and downloading them as original files or Premiere-compatible MP4.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://reddit.com/*",
    "https://v.redd.it/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipCatch - MP4 / Original"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "version_name": "1.9.5"
}
